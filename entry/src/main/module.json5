              { "scheme": "http", "host": "yt.cyberhost.uk" },
              { "scheme": "http", "host": "ytb.trom.tf" },
              { "scheme": "http", "host": "ytprivate.com" },
              { "scheme": "http", "host": "bandcamp.com" },
              { "scheme": "vnd.youtube" },
              { "scheme": "vnd.youtube.launch" }
            ]
          },
          // RouterActivity's SEND text/plain filter: the system share panel's text and links.
          {
            "actions": [
              "ohos.want.action.sendData"
            ],
            "uris": [
              { "scheme": "file", "utd": "general.text", "maxFileSupported": 1 },
              { "scheme": "file", "utd": "general.hyperlink", "maxFileSupported": 1 }
            ]
          },
          // PanicResponderActivity: info.guardianproject.panic.action.TRIGGER.
          {
            "actions": [
              "info.guardianproject.panic.action.TRIGGER"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        // NotificationWorker: the periodic new-streams check (WorkManager -> WorkScheduler).
        "name": "NotificationWorkerAbility",
        "srcEntry": "./ets/workers/NotificationWorkerAbility.ets",
        "type": "workScheduler",
        "exported": false
      },
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}