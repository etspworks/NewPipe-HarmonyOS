              { "scheme": "http", "host": "vid.mint.lgbt" },
              { "scheme": "http", "host": "vid.puffyan.us" },
              { "scheme": "http", "host": "video.lqdn.fr" },
              { "scheme": "http", "host": "video.ploud.fr" },
              { "scheme": "http", "host": "www.invidio.us" },
              { "scheme": "http", "host": "www.soundcloud.com" },
              { "scheme": "http", "host": "www.youtube-nocookie.com" },
              { "scheme": "http", "host": "www.youtube.com" },
              { "scheme": "http", "host": "y.com.cm" },
              { "scheme": "http", "host": "y2u.be" },
