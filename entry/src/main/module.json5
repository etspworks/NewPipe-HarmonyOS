{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // phone was the only entry since the port landed, which is why a tablet or 2-in-1 user could
    // not install at all. Nothing about this app is phone-only: the grid lanes already widen with
    // the screen and the 840vp branch already exists. The one capability that differs by profile,
    // SystemCapability.FileManagement.UserFileService.FolderSelection (2-in-1 only), is already
    // behind a runtime canIUse in FileAccess.canPickDirectory().
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // bundleManager.canOpenLink() throws 17700056 for a scheme that is not listed here. Only
    // the two the external-player hand-off ever asks about - it permits querying these,
    // nothing more.
    "querySchemes": [
      "http",
      "https"
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        // system_grant, normal level. Required by fileShare.persistPermission /
        // activatePermission - the takePersistableUriPermission analogue, without which a picked
        // URI grant dies with the process. Granted on this handset (reqPermissionStates 0).
        //
        // ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY was declared here too and has been
        // removed. It installs, it appears in the bundle, and requesting it answers
        // authResults=2 - "the request is invalid" - in 271 ms with no human involved, leaving
        // the public Download root at 13900001 exactly as before. A prompt that buys nothing is
        // worse than no prompt. Full measurement: docs/qa/evidence/fix-T-0183b/probe2.txt.
        "name": "ohos.permission.FILE_ACCESS_PERSIST"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // ExitActivity.exitAndRemoveFromRecentApps(): the panic trigger is the only caller of
        // terminateSelf(), and the app must leave the recent-apps list with it.
        "removeMissionAfterTerminate": true,
        // Continuous-task modes this ability may request (KEEP_BACKGROUND_RUNNING +
        // backgroundModes + the task itself are all required). "audioPlayback" backs the
        // AVSession media task; "dataTransfer" backs downloads / feed update / subscription
        // import-export in ets/common/background/BackgroundWork.ts.
        "backgroundModes": [
          "audioPlayback",
          "dataTransfer"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
,
          // RouterActivity's VIEW filters: a supported service link another app opens. The
          // wildcard hosts (*.bandcamp.com, *.hooktube.com) have no skills form; the router
          // rejects anything it cannot resolve with its own "unsupported URL" dialog.
          // HarmonyOS limit: an implicit http/https link goes to the system browser, not to a
          // chooser - only a domainVerify App Linking app (domain owner's applinking.json) can take
          // it. These host entries mirror the source but do not win that start; vnd.youtube and
          // the share panel (sendData below) are what reach the router from another app.
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              { "scheme": "https", "host": "dev.invidio.us" },
              { "scheme": "https", "host": "eduvid.org" },
              { "scheme": "https", "host": "framatube.org" },
              { "scheme": "https", "host": "hooktube.com" },
              { "scheme": "https", "host": "indymotion.fr" },
              { "scheme": "https", "host": "inv.riverside.rocks" },
              { "scheme": "https", "host": "invidio.us" },
              { "scheme": "https", "host": "invidiou.site" },
              { "scheme": "https", "host": "invidious-us.kavin.rocks" },
              { "scheme": "https", "host": "invidious.048596.xyz" },
              { "scheme": "https", "host": "invidious.blamefran.net" },
              { "scheme": "https", "host": "invidious.exonip.de" },
              { "scheme": "https", "host": "invidious.fdn.fr" },
              { "scheme": "https", "host": "invidious.kavin.rocks" },
              { "scheme": "https", "host": "invidious.moomoo.me" },
